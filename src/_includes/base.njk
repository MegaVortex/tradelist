<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="UTF-8">
      <meta http-equiv="Content-Security-Policy" content="default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; child-src 'none'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://drive.google.com https://lh3.googleusercontent.com; connect-src 'self' http://127.0.0.1:3042 https://api.web3forms.com;">
      <link href="{{ '/vendor/jsoneditor/jsoneditor.min.css' | url }}" rel="stylesheet" type="text/css">
      <script src="{{ '/vendor/jsoneditor/jsoneditor.min.js' | url }}"></script>
      <script src="{{ '/scripts/purify.min.js' | url }}"></script>
      <script src="{{ '/scripts/security.js' | url }}"></script>
      <link href="{{ '/vendor/bootstrap-icons/bootstrap-icons.min.css' | url }}" rel="stylesheet">
      <base href="{{ pathPrefix or '/' }}">
      <link href="{{ '/styles/bootstrap.min.css' | url }}" rel="stylesheet">
      <link href="{{ '/styles/clusterize.css' | url }}" rel="stylesheet">
      <link rel="icon" href="{{ '/favicon.ico' | url }}" type="image/x-icon">
      <link rel="stylesheet" href="/tradelist/styles/global.css">
      <link rel="stylesheet" href="/tradelist/styles/show.css">
      <title>
         {% block title %}Vortex Trade List{% endblock %}
      </title>
   </head>
   <body>
      <header class="navbar custom-navbar">
         <div class="navbar-left">
            <span class="site-title">Vortex Trade List</span>
         </div>
         <div class="navbar-center">
            <nav id="main-nav" class="nav nav-pills justify-content-center">
               <a class="nav-link{% if page.url == '/' %} active{% endif %}" href="{{ '/' | url }}">Home</a>
               <a class="nav-link{% if page.url == '/shows/' %} active{% endif %}" href="{{ '/shows/' | url }}">Browse Shows</a>
               <a class="nav-link{% if page.url == '/va/' %} active{% endif %}" href="{{ '/va/' | url }}">Various Artists</a>
               <a class="nav-link{% if page.url == '/comp/' %} active{% endif %}" href="{{ '/comp/' | url }}">Compilations</a>
               <a class="nav-link{% if page.url == '/updates/' %} active{% endif %}" href="{{ '/updates/' | url }}">Updates</a>
               {% if environment == "dev" %}
                  <a class="nav-link{% if page.url == '/private/' %} active{% endif %}" href="{{ '/private/' | url }}">Private</a>
               {% endif %}
            </nav>
         </div>
         <div class="navbar-right">
            {% if currentShow and environment == "dev" %}
               <button class="btn btn-sm btn-outline-secondary json-editor-trigger" style="font-size: 0.75rem; padding: 2px 6px;" data-show-id="{{ currentShow.fileSlug }}" data-show-type="{% if currentShow.isCompilation %}compilation{% elif currentShow.isVA %}va{% elif currentShow.isPrivate %}private{% else %}regular{% endif %}" title="Edit this show">✏️</button>
            {% endif %}
            {% if currentShow and currentShow.tradeLabel is defined %}
               {% if currentShow.tradeLabel == 'NT' %}
                  <button class="btn btn-sm btn-outline-secondary disabled me-2" style="font-size: 0.75rem; padding: 2px 6px;" disabled="disabled" title="Not available for trade">➕</button>
               {% else %}
                  <button class="btn btn-outline-success add-to-cart me-2" style="font-size: 0.75rem; padding: 2px 6px;" data-id="{{ currentShow.fileSlug }}" title="Add this show to your trade cart">➕</button>
               {% endif %}
            {% endif %}
            <button class="btn btn-sm btn-cart" data-bs-toggle="modal" data-bs-target="#cartModal">🛒 Cart</button>
         </div>
      </header>
      <main>
         {% block content %}{% endblock %}
         {% if currentShow and (currentShow.created or currentShow.lastUpdated) %}
           {% set createdTs = (currentShow.created | toInt) %}
           {% set updatedTs = (currentShow.lastUpdated | toInt) %}
           <div class="meta-timestamps">
             {% if createdTs %}
               <div><span class="label">Created:</span><span class="value">{{ createdTs | date('dd LLL yyyy hh:mm a') }}</span></div>
             {% endif %}
             {% if updatedTs and updatedTs != createdTs %}
               <div><span class="label">Updated:</span><span class="value">{{ updatedTs | date('dd LLL yyyy hh:mm a') }}</span></div>
             {% endif %}
           </div>
         {% endif %}
      </main>
	  {% if currentShow %}
	     <script type="application/json" id="all-shows-data">{{ currentShow | jsonScript | safe }}</script>
	     <script src="{{ '/scripts/page-data.js' | url }}"></script>
	  {% endif %}
	  <footer style="padding: 0.75rem 2rem 1.25rem; text-align: center; font-size: 0.75rem; color: #888;">
         Vortex © 2025
      </footer>
      <script src="{{ '/scripts/bootstrap.bundle.min.js' | url }}"></script>
   </body>
</html>
