{
  "name": "tl_web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean:public": "node scripts/clean-public.cjs",
    "build": "npm run clean:public && eleventy && npm run check:production-output",
    "build:dev": "npm run clean:public && cross-env ELEVENTY_ENV=dev eleventy",
    "check:production-output": "node scripts/check-production-output.cjs",
    "save-server": "node dev-server.js",
    "serve:dev": "cross-env ELEVENTY_ENV=dev eleventy --serve",
    "serve:static": "npx -y http-server@14 ./public -p 8080 -c-1",
    "test:e2e": "playwright test",
    "test:security": "node --test tests/node/dev-server-security.spec.cjs",
    "test:ui": "playwright test --ui",
    "test:update": "playwright test -u"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@playwright/test": "^1.56.1",
    "cross-env": "^7.0.3",
    "http-server": "^14.1.1"
  },
  "dependencies": {
    "bootstrap": "^5.3.6",
    "electron": "^36.5.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "glightbox": "^3.3.1",
    "iso-639-1": "^3.1.5",
    "luxon": "^3.6.1",
    "nodemailer": "^7.0.3",
    "photoswipe": "^5.4.4"
  }
}
